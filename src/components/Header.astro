---
interface Props {
  name: string;
  resume?: string;
}

const { name, resume } = Astro.props;
// Same-page anchors on the home page, absolute links everywhere else.
const home = Astro.url.pathname === '/' ? '' : '/';
const initials = name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="wordmark" href="/">
      <span class="wordmark__dot" aria-hidden="true"></span>
      <span class="wordmark__full">{name}</span>
      <span class="wordmark__short" aria-hidden="true">{initials}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        <li><a href={`${home}#work`}>Work</a></li>
        <li><a href={`${home}#about`}>About</a></li>
        {
          resume && (
            <li>
              <a href={resume} target="_blank" rel="noopener">
                Résumé<span class="nav__ext" aria-hidden="true">↗</span>
              </a>
            </li>
          )
        }
        <li><a href={`${home}#contact`}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  /* Hairline appears once the page scrolls. Longhands so minifiers can't
     fold the timeline into the `animation` shorthand (Chrome rejects that). */
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation-name: header-rule;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: scroll();
      animation-range: 0 80px;
    }
  }

  @keyframes header-rule {
    from {
      border-bottom-color: transparent;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .wordmark__short {
    display: none;
  }

  .nav {
    display: flex;
    gap: clamp(14px, 2.4vw, 36px);
  }

  .nav a {
    position: relative;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 8px;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .nav__ext {
    margin-left: 2px;
  }

  /* Phones show initials; the full name stays available to screen readers. */
  @media (max-width: 560px) {
    .wordmark__full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .wordmark__short {
      display: inline;
    }
  }
</style>
