---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reel from '../components/Reel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getSite, pad } from '../lib/content';

const site = await getSite();
const projects = await getProjects();
const { about } = site;
---

<BaseLayout>
  <!-- Hero ------------------------------------------------------------ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner container">
      <p class="hero__eyebrow label rise">
        <span>{site.role}</span>
        <span class="hero__eyebrow-tagline">{site.tagline}</span>
      </p>

      <h1 id="hero-title" class="hero__name rise" style="--i: 1">
        {site.name.split(' ').map((word) => <span class="hero__word">{word} </span>)}
      </h1>

      <dl class="title-block rise" style="--i: 2">
        {
          site.titleBlock.map(({ label, value }) => (
            <div class="title-block__cell">
              <dt class="label">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__foot rise" style="--i: 3">
        <p class="hero__lede">{site.lede}</p>
        <div class="hero__actions">
          <a class="button" href="#work">See the work <span aria-hidden="true">↓</span></a>
          {
            site.contact.resume && (
              <a class="button button--ghost" href={site.contact.resume} target="_blank" rel="noopener">
                Résumé <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <Reel poster={site.reel.poster} src={site.reel.src} srcMobile={site.reel.srcMobile} label={site.reel.label} />
  </section>

  <!-- Logos + where the work has been seen --------------------------- -->
  <div class="logos on-dark">
    <section class="container" aria-label="Where I’ve worked and studied">
      <ul class="logos__list">
        {
          site.logos.map((logo) => (
            <li class="logos__item">
              <Image src={logo.image} alt={logo.name} height={84} densities={[1, 2]} />
            </li>
          ))
        }
      </ul>
    </section>
    {
      site.onScreen && (
        <section class="on-screen container" aria-labelledby="on-screen-title">
          <h2 id="on-screen-title" class="label">
            {site.onScreen.label}
          </h2>
          <ul class="on-screen__list">
            {site.onScreen.platforms.map(({ name, accent }) => (
              <li class:list={['on-screen__item', { 'on-screen__item--accent': accent }]}>
                <svg class="on-screen__play" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M2.5 1.5v7l5.5-3.5z" />
                </svg>
                {name}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <!-- Work ------------------------------------------------------------ -->
  <section id="work" class="section" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head">
        <p class="label">Selected work <span class="count">({pad(projects.length)})</span></p>
        <h2 id="work-title" class="section-title">Things I’ve built and tested.</h2>
      </header>

      <ul class="work-grid">
        {
          projects.map((project, i) => (
            <li class="reveal">
              <ProjectCard project={project} index={i + 1} eager={i < 3} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- About ----------------------------------------------------------- -->
  <section id="about" class="about section" aria-labelledby="about-title">
    <div class="container">
      <header class="section-head">
        <p class="label">About</p>
        <h2 id="about-title" class="about__lead">{about.lead}</h2>
      </header>

      <div class="about__grid">
        <figure class="about__portrait reveal">
          <Image src={about.portrait} alt={about.portraitAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 960px) 520px, 92vw" />
        </figure>
        <div class="about__body">
          {about.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class="about__block">
        <h3 class="label">Experience</h3>
        <ol class="timeline">
          {
            site.experience.map((item) => (
              <li class="timeline__row">
                <span class="timeline__dates label">{item.dates}</span>
                <span class="timeline__org">{item.org}</span>
                <span class="timeline__role">
                  {item.role}
                  {item.location && <span class="timeline__location">{item.location}</span>}
                </span>
                {item.note && <span class="timeline__note">{item.note}</span>}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="about__block">
        <h3 class="label">Capabilities</h3>
        <div class="capabilities">
          {
            site.capabilities.map(({ group, items }) => (
              <div class="capabilities__group">
                <h4 class="capabilities__title">{group}</h4>
                <ul class="capabilities__list">
                  {items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero ---------------------------------------------------------------- */

  .hero {
    padding-top: clamp(28px, 5vw, 72px);
  }

  .hero__inner {
    container-type: inline-size;
    padding-bottom: clamp(32px, 4.5vw, 64px);
  }

  .hero__eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink);
  }

  .hero__eyebrow-tagline {
    color: var(--muted);
  }

  .hero__name {
    margin-top: clamp(10px, 1.6cqi, 22px);
    margin-left: -0.045em;
    font-size: 11.45cqi;
    font-weight: 800;
    font-stretch: 112%;
    line-height: 0.84;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .title-block {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(24px, 3.6cqi, 48px);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .title-block__cell {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px 18px 18px;
    border-left: 1px solid var(--rule);
  }

  .title-block__cell:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .title-block dd {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px 48px;
    margin-top: clamp(28px, 4cqi, 56px);
  }

  .hero__lede {
    max-width: 24ch;
    font-size: clamp(1.375rem, 2.6cqi, 2.375rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Phones + small tablets: compact label/value rows. */
  @media (max-width: 759px) {
    .title-block {
      grid-template-columns: 1fr;
    }

    .title-block__cell {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 12px;
      padding: 12px 0;
      border-left: 0;
    }

    .title-block__cell + .title-block__cell {
      border-top: 1px solid var(--rule);
    }

    .title-block dt {
      padding-top: 0.2em;
    }
  }

  @media (max-width: 640px) {
    .hero__eyebrow-tagline {
      display: none;
    }

    /* Stack the name for a bigger, punchier masthead on phones. */
    .hero__name {
      font-size: 21.5cqi;
      line-height: 0.86;
    }

    .hero__word {
      display: block;
    }
  }

  /* Logos --------------------------------------------------------------- */

  .logos {
    background: var(--ink);
    color: var(--on-dark);
    padding-block: clamp(48px, 7vw, 104px);
  }

  /* With the "seen on" line as a footer strip, match the space below it to the space above it. */
  .logos:has(.on-screen) {
    padding-bottom: clamp(26px, 3.2vw, 46px);
  }

  .logos__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
  }

  .logos__item {
    display: grid;
    place-items: center;
  }

  .logos__item img {
    width: auto;
    height: clamp(50px, 7.6vw, 112px);
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .logos__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }

  /* Seen on: a quiet line under the logos. */
  .on-screen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px clamp(28px, 3vw, 44px);
    margin-top: clamp(44px, 5.5vw, 80px);
    padding-top: clamp(26px, 3.2vw, 46px);
    border-top: 1px solid var(--rule-dark);
  }

  .on-screen__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px clamp(28px, 3vw, 44px);
  }

  .on-screen__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--on-dark-muted);
    font-size: clamp(1.0625rem, 1.55vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .on-screen__play {
    width: 0.55em;
    height: 0.55em;
    fill: rgb(241 240 236 / 0.32);
  }

  .on-screen__item--accent .on-screen__play {
    fill: var(--wdi-blue);
  }

  /* Work ---------------------------------------------------------------- */

  .count {
    color: var(--ink);
  }

  .work-grid {
    display: grid;
    gap: clamp(44px, 5vw, 72px) clamp(16px, 2vw, 28px);
  }

  @media (min-width: 640px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* About --------------------------------------------------------------- */

  .about {
    border-top: 1px solid var(--rule);
  }

  .about__lead {
    max-width: 27ch;
    font-size: clamp(1.875rem, 3.7vw, 3.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .about__grid {
    display: grid;
    gap: clamp(32px, 5vw, 80px);
  }

  .about__portrait img {
    width: 100%;
    border-radius: var(--radius);
  }

  .about__body {
    display: grid;
    align-content: end;
    gap: 1.1em;
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .about__body p:last-child {
    color: var(--ink);
    font-weight: 500;
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .about__portrait {
      max-width: 520px;
    }
  }

  .about__block {
    display: grid;
    gap: 20px;
    margin-top: clamp(72px, 10vw, 144px);
  }

  .timeline {
    border-top: 1px solid var(--ink);
  }

  .timeline__row {
    display: grid;
    gap: 6px 24px;
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
  }

  .timeline__dates {
    padding-top: 0.35em;
    color: var(--ink);
  }

  .timeline__org {
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .timeline__role {
    display: grid;
    gap: 2px;
    padding-top: 0.2em;
    font-weight: 500;
  }

  .timeline__location {
    color: var(--muted);
    font-weight: 400;
  }

  .timeline__note {
    padding-top: 0.2em;
    color: var(--ink-2);
    font-size: 0.96875rem;
    line-height: 1.5;
  }

  @media (min-width: 960px) {
    .timeline__row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3.2fr) minmax(0, 3fr) minmax(0, 4fr);
      align-items: start;
    }
  }

  .capabilities {
    display: grid;
    gap: 36px 28px;
    border-top: 1px solid var(--ink);
    padding-top: 24px;
  }

  @media (min-width: 640px) {
    .capabilities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .capabilities {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .capabilities__title {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .capabilities__list {
    display: grid;
    gap: 6px;
    margin-top: 14px;
    color: var(--ink-2);
  }

  .capabilities__list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .capabilities__list li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--accent);
    transform: translateY(-2px);
  }
</style>
