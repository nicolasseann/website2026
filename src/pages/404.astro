---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="missing container">
    <p class="label">Error 404</p>
    <h1 class="missing__title">This part isn’t in the assembly.</h1>
    <p class="missing__body">The page you’re looking for has moved or never existed.</p>
    <a class="button" href="/">Back to the portfolio <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: clamp(96px, 16vw, 220px);
  }

  .missing__title {
    max-width: 14ch;
    font-size: clamp(2.75rem, 7.5vw, 7.5rem);
    font-weight: 800;
    font-stretch: 110%;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .missing__body {
    color: var(--ink-2);
    font-size: 1.25rem;
  }
</style>
